<!--
  Derivative of the vendored x2.xml (see VENDORED_FROM.md) - Apache-2.0,
  original by Skydio via google-deepmind/mujoco_menagerie, commit
  8161bba264d7fa7c99ca301e91e7fb44737676ad. Two changes from x2.xml, both
  marked below:

  1. (M0) An explicit `resolution` attribute on the "track" camera.

     Why: MuJoCo's per-camera offscreen render resolution
     (`mjModel.cam_resolution`, what mujoco_ros2_control_plugins/CameraPlugin
     actually publishes) comes only from the camera's own `resolution="w h"`
     attribute and defaults to 1x1 if unset - it does NOT inherit
     <visual><global offwidth/offheight> (verified empirically: setting
     offwidth/offheight to 640x480 in a wrapper scene left `cam_resolution`
     at [[1, 1]], confirmed via the `mujoco` Python bindings).

  2. (M3) A new "nose_cam" camera, body-fixed (mode defaults to "fixed" -
     rotates rigidly with the body), pointed forward-and-slightly-down.

     Why: "track" is mode="trackcom" - confirmed empirically (via the mujoco
     Python bindings: cam_xmat/cam_xpos identical across yaw=0/45/90deg) that
     it keeps a WORLD-FIXED orientation and only translates with the drone's
     center of mass, i.e. it does NOT rotate with the body at all. That makes
     it useless for M3's optic-flow controller, which needs the camera's own
     rotation to sweep the visual surround across the frame during a yaw
     disturbance. "nose_cam" has no `mode` attribute (defaults to "fixed"),
     confirmed empirically to both rotate with yaw and produce a visibly
     different rendered image at yaw=0/10/30deg (mean abs pixel diff ~11-12
     out of 255, vs "track"'s near-zero diff for the same test). See
     NOTES.md's "## M3" section.

  Since x2.xml doesn't set `resolution` and MJCF's <include> mechanism can't
  patch an attribute onto / add a sibling element to an included file's
  existing elements (no element-merge/override semantics), a derivative file
  was the only option that (a) doesn't hand-edit the vendored original and
  (b) doesn't fork the license/asset files, only the tiny top-level MJCF
  describing the body/cameras.

  Keep this file's diff against x2.xml to exactly these two changes.
-->
<mujoco model="Skydio X2">
  <compiler autolimits="true" assetdir="assets"/>

  <option timestep="0.01" density="1.225" viscosity="1.8e-5"/>

  <default>
    <default class="x2">
      <geom mass="0"/>
      <motor ctrlrange="0 13"/>
      <mesh scale="0.01 0.01 0.01"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="box"/>
        <default class="rotor">
          <geom type="ellipsoid" size=".13 .13 .01"/>
        </default>
      </default>
      <site group="5"/>
    </default>
  </default>

  <asset>
    <texture type="2d" file="X2_lowpoly_texture_SpinningProps_1024.png"/>
    <material name="phong3SG" texture="X2_lowpoly_texture_SpinningProps_1024"/>
    <material name="invisible" rgba="0 0 0 0"/>

    <mesh class="x2" file="X2_lowpoly.obj"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="x2" pos="0 -1 2"/>
    <body name="x2" pos="0 0 0.1" childclass="x2">
      <freejoint/>
      <!-- CHANGED from x2.xml: added resolution="640 480" (see file header). -->
      <camera name="track" pos="-1 0 .5" xyaxes="0 -1 0 1 0 2" mode="trackcom" resolution="640 480"/>
      <!-- ADDED (not in x2.xml, see file header): body-fixed nose camera for
           M3 - mode defaults to "fixed" (rotates rigidly WITH the body),
           unlike "track" above which is mode="trackcom" (world-fixed
           orientation, does NOT rotate with the body - confirmed empirically
           useless for detecting the drone's own yaw rotation via optic flow,
           see NOTES.md's "## M3" section). xyaxes points it along the body's
           +X (forward, REP103) at a slight downward tilt so the textured
           ground plane fills a useful fraction of the frame at typical hover
           altitude. -->
      <camera name="nose_cam" pos="0.15 0 0.0" xyaxes="0 -1 0 0.30 0 0.95" resolution="640 480"/>
      <site name="imu" pos="0 0 .02"/>
      <geom material="phong3SG" mesh="X2_lowpoly" class="visual" quat="0 0 1 1"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .02"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .06"/>
      <geom class="collision" size=".05 .027 .02" pos="-.07 0 .065"/>
      <geom class="collision" size=".023 .017 .01" pos="-.137 .008 .065" quat="1 0 0 1"/>
      <geom name="rotor1" class="rotor" pos="-.14 -.18 .05" mass=".25"/>
      <geom name="rotor2" class="rotor" pos="-.14 .18 .05" mass=".25"/>
      <geom name="rotor3" class="rotor" pos=".14 .18 .08" mass=".25"/>
      <geom name="rotor4" class="rotor" pos=".14 -.18 .08" mass=".25"/>
      <geom size=".16 .04 .02" pos="0 0 0.02" type="ellipsoid" mass=".325" class="visual" material="invisible"/>
      <site name="thrust1" pos="-.14 -.18 .05"/>
      <site name="thrust2" pos="-.14 .18 .05"/>
      <site name="thrust3" pos=".14 .18 .08"/>
      <site name="thrust4" pos=".14 -.18 .08"/>
    </body>
  </worldbody>

  <actuator>
    <motor class="x2" name="thrust1" site="thrust1" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="thrust2" site="thrust2" gear="0 0 1 0 0 .0201"/>
    <motor class="x2" name="thrust3" site="thrust3" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="thrust4" site="thrust4" gear="0 0 1 0 0 .0201"/>
  </actuator>

  <sensor>
    <gyro name="body_gyro" site="imu"/>
    <accelerometer name="body_linacc" site="imu"/>
    <framequat name="body_quat" objtype="site" objname="imu"/>
  </sensor>

  <keyframe>
    <key name="hover" qpos="0 0 .3 1 0 0 0" ctrl="3.2495625 3.2495625 3.2495625 3.2495625"/>
  </keyframe>
</mujoco>
